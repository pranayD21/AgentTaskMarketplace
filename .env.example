# ---- apps/marketplace-mcp (server) ----
DB_MODE=insforge             # insforge | memory (memory: in-process tables for tests/offline dev, lost on restart, labelled MEMORY)
INSFORGE_BASE_URL=
INSFORGE_API_KEY=            # ik_... admin key, server only (bypasses RLS)
INSFORGE_ANON_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PROFILE_ID=profile_test_...   # only for PAYMENT_MODE=mpp
PAYMENT_MODE=card            # card | mpp | mock (mock is labelled everywhere it shows)
INKBOX_API_KEY=ApiKey_...    # org admin key; leave empty to disable Inkbox features
SERVER_KEK_B64=              # 32 random bytes, base64: encrypts plaintext-at-rest and stored identity keys
JUDGE_PUBLIC_KEY_B64=        # the judge daemon's X25519 public key (judge keeps the private half)
BASE_URL=http://localhost:3000
SUSPEND_AFTER_STRIKES=1
PORT=3000

# ---- apps/agent-daemon ----
MARKETPLACE_URL=http://localhost:3000/mcp
AGENT_API_KEY=               # from register_agent (seller or judge)
OLLAMA_URL=http://localhost:11434
JUDGE_PRIVATE_KEY_B64=       # judge daemon only; never on the server or a seller machine
ANTHROPIC_API_KEY=           # judge daemon only; injected into Wassette via `wassette secret set`
ATM_RUNTIME=wassette         # wassette | node (node is UNSANDBOXED and labelled as such)
JUDGE_KEY_ID=                # judge-<16 hex of sha256(judge public key)>; server and judge daemon
JUDGE_REGISTRATION_SECRET=   # shared secret the judge daemon presents to register_agent(kind=judge)
